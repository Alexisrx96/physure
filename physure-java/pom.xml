<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- Version is kept in sync with [workspace.package].version in the repo-root
       Cargo.toml by hand, mirroring physure-python/physure/__init__.py's
       __version__ - there is no cross-ecosystem version-sync tooling here. -->
  <groupId>io.github.alexisrx96</groupId>
  <artifactId>physure</artifactId>
  <version>0.3.0</version>
  <packaging>jar</packaging>

  <name>physure</name>
  <description>JVM JNI bindings for the high-performance physure core physics engine.</description>
  <url>https://github.com/Alexisrx96/physure</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://github.com/Alexisrx96/physure/blob/main/LICENSE</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Irvin Torres</name>
      <email>irvinrx1996@hotmail.com</email>
    </developer>
  </developers>

  <scm>
    <url>https://github.com/Alexisrx96/physure</url>
    <connection>scm:git:https://github.com/Alexisrx96/physure.git</connection>
    <developerConnection>scm:git:https://github.com/Alexisrx96/physure.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>8</maven.compiler.source>
    <maven.compiler.target>8</maven.compiler.target>
    <!-- Where `cargo build -p physure-java` leaves the native library the tests load. -->
    <physure.native.dir>${project.basedir}/../target/debug</physure.native.dir>
    <!-- Set by the native-access profile on Java 24+, empty before (older JVMs reject the option). -->
    <physure.native.access></physure.native.access>
    <!-- JaCoCo's agent line when the coverage profile is on; surefire appends it (@{argLine}) to its own options. -->
    <argLine></argLine>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Java 9+ rejects the obsolete-option notices of the 8 target; they are about the build, not the jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:-options</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <!-- The tests call the real native library, so build it first: `cargo build -p physure-java`. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <argLine>@{argLine} -Djava.library.path=${physure.native.dir} ${physure.native.access}</argLine>
        </configuration>
      </plugin>
      <!-- Required by Maven Central: sources + javadoc jars alongside the main jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>3.3.1</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals><goal>jar-no-fork</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <source>8</source>
          <failOnError>false</failOnError>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals><goal>jar</goal></goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- GPG signing and the Central Portal publish step only run under -Prelease,
       so a plain `mvn verify` works locally without any signing key configured. -->
  <profiles>
    <!-- Compile against the Java 8 API when the JDK can (9+): the source and target flags alone let a Java 9+ method
         compile into a jar that has to run on 8. JDK 8 itself has no release option, so it keeps source and target. -->
    <profile>
      <id>release-8-api</id>
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <maven.compiler.release>8</maven.compiler.release>
      </properties>
    </profile>
    <!-- Java 24 warns when System.loadLibrary is called without native access, and a later release will
         block it: NativeEngine loads the JNI library, so the tests say so up front. Applications that use
         the jar on Java 24+ enable native access for it (see README). -->
    <profile>
      <id>native-access</id>
      <activation>
        <jdk>[24,)</jdk>
      </activation>
      <properties>
        <physure.native.access>--enable-native-access=ALL-UNNAMED</physure.native.access>
      </properties>
    </profile>
    <!-- `mvn -Pcoverage test` writes target/site/jacoco/jacoco.xml, which SonarQube reads
         (sonar.coverage.jacoco.xmlReportPaths). Off by default: the agent is not needed to run the tests, and
         the release JDKs of the matrix do not all have a JaCoCo that reads their class files. -->
    <profile>
      <id>coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.13</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>test</phase>
                <goals>
                  <goal>report</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- true: a green java-release run is a public release, like PyPI and crates.io (decided 2026-10-30). -->
              <autoPublish>true</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>

WHITESPACE = _{ " " | "\t" }
NEWLINE    = _{ "\r\n" | "\n" | "\r" }
COMMENT    = _{ ("//" | "#") ~ (!"\n" ~ !"\r" ~ ANY)* }

// `in` is deliberately absent: it is the symbol for inch. `let` stays reserved with no rule
// behind it so the retired `let ... in ...` form fails to parse instead of quietly meaning
// "let times inches".
keyword     = @{ ("let" | "if" | "then" | "else" | "where" | "return") ~ !(ASCII_ALPHANUMERIC | "_") }
identifier  = @{ !keyword ~ (ASCII_ALPHA | "π" | "θ" | "λ" | "μ" | "Δ" | "σ" | "Ω" | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
infinity_lit = @{ ("+" | "-")? ~ ("infinity" | "inf" | "oo" | "∞") }
number       = @{ infinity_lit | (ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? ~ ( ^"e" ~ ("+" | "-")? ~ ASCII_DIGIT+ )?) }

sigma_op        = { "sigma" | "σ" }
uncertainty_op  = { "+/-" | "±" }
uncertainty_val = { number ~ (sigma_op | "%")? }
// An asymmetric measurement, written the way a paper writes it: `12.3 +/- (0.5, 0.4) pb` is
// +0.5 and -0.4, upper first, in the order `+/-` reads. The grammar only says there are two
// halves; which one is which is decided in `parser.rs`, where two adjacent lines assign them,
// so the other order costs one swap there and this note here.
// The parentheses are what keep this out of the binary operators' way: `12.3 + (0.5)` never
// reaches here, because the `+/-` and `±` lookahead that guards the whole rule fails on a
// bare `+`.
uncertainty_pair = { "(" ~ uncertainty_val ~ "," ~ uncertainty_val ~ ")" }
uncertainty     = { uncertainty_op ~ (uncertainty_pair | uncertainty_val) }

_unit_ws        = _{ (" " | "\t")+ }
_unit_char      = _{ LETTER | "_" | "°" | "%" | "$" }
_is_unit_start  = _{ &(!keyword ~ _unit_char) }
_unit_op_term     = _{ "*" | "/" }
_has_unit_op      = _{ &(_unit_op_term) | &((" " | "\t")+ ~ _unit_op_term) }
// `!"("` keeps a call out of the unit chain: in `100.0 kPa * sin(x)` the symbol `sin` is
// otherwise indistinguishable from a unit, and swallowing it drops the argument list.
unit_term         = @{ !keyword ~ _unit_char ~ (_unit_char | ASCII_DIGIT)* ~ !"(" ~ (_unit_ws* ~ "^" ~ _unit_ws* ~ ("+" | "-")? ~ ASCII_DIGIT+)? }
unit_primary      = _{ unit_term | "(" ~ unit_expr ~ ")" }
unit_expr         = { unit_primary ~ (_has_unit_op ~ (" " | "\t")* ~ ("*" | "/") ~ (" " | "\t")* ~ unit_primary)* }

vector_literal  = { "[" ~ (expr ~ ("," ~ expr)*)? ~ "]" ~ (_no_nl ~ _is_unit_start ~ unit_expr)? }

_is_uncertainty = _{ &("+/-" | "±") }
_no_nl = _{ !("\r" | "\n") }
quantity = {
    ("(" ~ expr ~ (_is_uncertainty ~ uncertainty)? ~ ")" ~ (_no_nl ~ _is_unit_start ~ unit_expr)? ~ (_is_uncertainty ~ uncertainty)?)
  | (number ~ (_is_uncertainty ~ uncertainty)? ~ (_no_nl ~ _is_unit_start ~ unit_expr)? ~ (_is_uncertainty ~ uncertainty)?)
}

// Only the Python-style `.2f`/`.3e` spec. A bare `ASCII_ALPHA+` also matched, which made
// `cond ? a : b` unparseable: `: b` looked like a format spec and ate the ternary's colon.
format_spec = @{ "." ~ ASCII_DIGIT+ ~ ASCII_ALPHA* }
op_format   = { ":" ~ format_spec }

op_add      = { "+" }
op_sub      = { "-" }
op_mul      = { "*" }
op_div      = { "/" }
op_pow      = { "^" }
op_convert  = { "=>" }
op_compare  = { "==" | "!=" | ">=" | "<=" | ">" | "<" | "≈" }
op_range    = { ".." }

_nl         = _{ (NEWLINE | WHITESPACE)* }
_is_if      = _{ &"if" }
if_expr     = { _is_if ~ "if" ~ _nl ~ expr ~ _nl ~ "then" ~ _nl ~ expr ~ _nl ~ "else" ~ _nl ~ expr }

// Local bindings read the way they do on paper: `x * 2.0 where x = 10.0 m`. Later bindings
// see earlier ones, so `a * b where a = 2 m, b = a * 3` is well defined.
_is_where   = _{ &"where" }
where_bind  = { identifier ~ _nl ~ "=" ~ _nl ~ base_expr }
where_expr  = { "where" ~ _nl ~ where_bind ~ (_nl ~ "," ~ _nl ~ where_bind)* }

_is_str_start  = _{ &"\"" }
_is_func_start = _{ &(identifier ~ "(") }
_is_vec_start  = _{ &"[" }
_is_num_start  = _{ &(ASCII_DIGIT | "+" | "-" | "infinity" | "inf" | "oo" | "∞" | "(") }

primary_base   = _{
    (_is_str_start ~ string_lit)
  | (_is_func_start ~ function_call)
  | (_is_vec_start ~ vector_literal)
  | (_is_num_start ~ quantity)
  | identifier
  | ("(" ~ expr ~ ")")
}
_has_dot      = _{ !".." ~ "." }
method_call   = { primary_base ~ (_has_dot ~ identifier ~ "(" ~ (call_arg ~ ("," ~ call_arg)*)? ~ ")")+ }
primary       = _{ primary_base ~ (_has_dot ~ identifier ~ "(" ~ (call_arg ~ ("," ~ call_arg)*)? ~ ")")* }

_is_pow     = _{ &"^" }
_is_minus   = _{ &"-" }
factor      = { (_is_minus ~ op_sub)? ~ primary ~ (_is_pow ~ op_pow ~ primary)? }

_is_delim         = _{ "," | ")" | "]" | "}" | ":" | "=" | "=>" | ".." | "?" | "then" | "else" | "where" | "return" }
_is_implicit_mul  = _{ _no_nl ~ !op_sub ~ !_is_delim }
_is_mul_div       = _{ &("*" | "/") }
term              = { factor ~ ((_is_mul_div ~ (op_mul | op_div) ~ factor) | (_is_implicit_mul ~ factor))* }

_is_compare = _{ &("==" | "!=" | ">=" | "<=" | ">" | "<" | "≈") }
_is_format  = _{ &(":" ~ format_spec) }
comp_expr   = { term ~ (_is_compare ~ op_compare ~ term)* ~ (_is_format ~ op_format)? }

// `..` sits at the same level as `+`/`=>` so a range's endpoints can carry units and
// conversions ("0 m .. 2.0 km => m") without parentheses.
_is_add_sub_conv = _{ &("+" | "-" | "=>" | "..") }
base_expr   = { comp_expr ~ (_is_add_sub_conv ~ (op_add | op_sub | op_convert | op_range) ~ comp_expr)* }

_is_ternary = _{ &"?" }
ternary_op  = { "?" ~ _nl ~ base_expr ~ _nl ~ ":" ~ _nl ~ base_expr }
expr        = { ((_is_if ~ if_expr) | (base_expr ~ (_is_ternary ~ ternary_op)?)) ~ (_is_where ~ where_expr)? }

// `name: value` is accepted alongside `name = value`; the plain `expr` branch stays last
// so a format spec (`x:.2f`) still wins, since `.2f` is not a valid expression.
call_arg      = { (identifier ~ ("=" | ":") ~ expr) | expr }
_is_func_call = _{ &(identifier ~ "(") }
function_call = { _is_func_call ~ identifier ~ "(" ~ (call_arg ~ ("," ~ call_arg)*)? ~ ")" }
param_item    = { identifier ~ (":" ~ unit_expr)? }
params        = { param_item ~ ("," ~ param_item)* }

import_symbol_item = { identifier ~ ("as" ~ identifier)? }
import_symbols     = { "*" | (import_symbol_item ~ ("," ~ import_symbol_item)*) }

import_stmt = {
    ("use" ~ import_symbols ~ "from" ~ (string_lit | identifier))
  | ("import" ~ (string_lit | identifier) ~ ("as" ~ identifier)?)
}

export_stmt   = { "export" ~ identifier ~ ("as" ~ (string_lit | identifier))? }
assignment    = { identifier ~ "=" ~ (NEWLINE | WHITESPACE)* ~ expr }
_nl_indent    = @{ NEWLINE ~ (" " | "\t")+ }
block_body    = { (_nl_indent ~ stmt)+ }
assignment_fn = { identifier ~ "(" ~ params? ~ ")" ~ "=" ~ (block_body | expr) }
function_def  = { "fn" ~ identifier ~ "(" ~ params? ~ ")" ~ "=" ~ (block_body | expr) }
raw_block     = @{ "```" ~ (!"```" ~ ANY)* ~ "```" }
string_lit    = @{ "\"" ~ (!"\"" ~ ANY)* ~ "\"" }

return_stmt   = { "return" ~ expr }
guard_if_stmt = { "if" ~ _nl ~ expr ~ _nl ~ "then" ~ _nl ~ return_stmt }

stmt_term       = _{ ";" | NEWLINE }
stmt            = { import_stmt | export_stmt | function_def | assignment_fn | assignment | guard_if_stmt | return_stmt | raw_block | expr }
_is_stmt_start  = _{ !(NEWLINE | COMMENT | EOI) }
program         = _{ SOI ~ (stmt_term | COMMENT)* ~ (_is_stmt_start ~ stmt ~ (stmt_term | COMMENT)*)* ~ EOI }

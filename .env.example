# Physure Local Pre-Push & Clean Environment Testing Configuration
# List target Python versions to test in clean, isolated virtual environments
TEST_PYTHON_VERSIONS=3.11,3.12,3.13,3.14

# Directory for fresh, isolated test virtualenvs
CLEAN_VENV_DIR=.fresh_test_venvs

# Control test suites to run during pre-push
RUN_RUST_TESTS=true
RUN_PYTHON_TESTS=true
FAIL_FAST=true

# Physure Environment Configuration Template
# Copy this file to .env and fill in your values (never commit .env to git)

# SonarQube / SonarCloud Server Configuration
SONAR_HOST_URL=http://sonar.localhost

# Tokens generated from SonarQube UI (User Account -> Security -> Tokens)
# Default token used for all projects if specific tokens are omitted:
SONAR_TOKEN=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional subproject-specific tokens:
SONAR_TOKEN_CORE=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SONAR_TOKEN_JAVA=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SONAR_TOKEN_CLI=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SONAR_TOKEN_LSP=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SONAR_TOKEN_SCRIPT=squ_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
